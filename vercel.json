{
    "services": {
        "web": {
            "root": "apps/web",
            "framework": "vite"
        },
        "data-service": {
            "root": "services/data-service"
        },
        "gateway": {
            "root": "services/gateway"
        }
    },
    "rewrites": [
        {
            "source": "/api/data-service(/.*)?",
            "destination": {
                "type": "service",
                "service": "data-service"
            }
        },
        {
            "source": "/api/gateway(/.*)?",
            "destination": {
                "type": "service",
                "service": "gateway"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "web"
            }
        }
    ]
}
